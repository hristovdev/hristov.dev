# Secrets are managed in Doppler, not in this file.
#
#   doppler setup                                  # once, per machine
#   doppler run -- docker compose --profile dev up # inject + run
#
# This file documents which variables the app reads. Create the same names as
# secrets in your Doppler project. A local .env is only a fallback for working
# without the Doppler CLI — it is gitignored and must never hold a live key.

# --- public (inlined into the client bundle at build time) ------------------
NEXT_PUBLIC_SITE_URL=https://hristov.dev

# --- server-only -----------------------------------------------------------
# Resend API key. https://resend.com/api-keys
# Required in production; if unset in development the contact form logs the
# submission to the server console instead of sending it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered. Defaults to site.email.
CONTACT_TO_EMAIL=hristo@hristov.dev

# Sender address. Must be on a domain verified in Resend.
# Defaults to "hristov.dev <website@hristov.dev>".
CONTACT_FROM_EMAIL=hristov.dev <website@hristov.dev>
